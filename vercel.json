{
    "version": 2,
    "builds": [
        {
            "src": "backend/src/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        }
    ],
    "rewrites": [
        {
            "source": "/api/cafe/:path*",
            "destination": "frontend/api/cafe/:path*"
        },
        {
            "source": "/api/sse/:path*",
            "destination": "frontend/api/sse/:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "backend/src/index.js"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "frontend/$1"
        }
    ],
    "env": {
        "NODE_ENV": "production",
        "DEPLOY_ID": "2026-04-01-23-07"
    }
}