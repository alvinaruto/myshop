{
    "version": 2,
    "builds": [
        {
            "src": "backend/src/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        }
    ],
    "rewrites": [
        {
            "source": "/api/cafe/(.*)",
            "destination": "frontend/api/cafe/$1"
        },
        {
            "source": "/api/sse/(.*)",
            "destination": "frontend/api/sse/$1"
        },
        {
            "source": "/api/(?!(cafe|sse)/)(.*)",
            "destination": "backend/src/index.js"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "frontend/$1"
        }
    ],
    "env": {
        "NODE_ENV": "production",
        "DEPLOY_ID": "2026-04-01-22-24"
    }
}